# Created by `npx convex dev` after you create a new Lunch Box project.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Set these in the Convex dashboard under Settings > Environment Variables.
# ADMIN_USERNAME=lunchbox-admin
# ADMIN_PASSWORD=choose-a-long-unique-password

# Set these in Convex Settings > Environment Variables (not in browser/VITE variables).
# SQUARE_ACCESS_TOKEN=your-production-access-token
# SQUARE_LOCATION_ID=your-production-location-id
# SQUARE_WEBHOOK_SIGNATURE_KEY=your-production-webhook-signature-key
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-deployment.convex.site/square-webhook
# SQUARE_API_BASE_URL=https://connect.squareup.com
# PUBLIC_SITE_URL=https://your-public-site.example/
